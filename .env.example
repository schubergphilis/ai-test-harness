# Copy to .env (gitignored) and fill in. Model aliases are declared in models.toml; this file only holds
# deployment-specific values. Never commit .env.
LITELLM_MASTER_KEY=sk-local-dev

# Sovereign upstream: an OpenAI-compatible endpoint (e.g. a litellm/vLLM server) hosting open-weights models.
# *_MODEL values are plain model names as listed by the upstream /v1/models.
SOVEREIGN_LITELLM_BASE_URL=https://litellm-sovereign.example.internal/v1
SOVEREIGN_LITELLM_API_KEY=sk-changeme
SOVEREIGN_MODEL=qwen3.8-flash-next-nvfp4

# Frontier upstream: an OpenAI-compatible proxy serving commercial models
UPSTREAM_LITELLM_BASE_URL=https://litellm.example.internal/v1
UPSTREAM_LITELLM_API_KEY=sk-changeme
ANTHROPIC_MODEL=aws/claude-5-5-opus
CHATGPT_MODEL=azure/gpt-6-1-sol

# Alias used by `make up` / `make test-native` (mock | sovereign | anthropic | chatgpt)
MODEL=mock

# Langfuse headless init (local dev only, `make up TRACING=1`)
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_SECRET_KEY=sk-lf-local-dev
